        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "const gun = (s) => { const [g, a, y] = s.split(\"-\").map(Number); return Date.UTC(y, a - 1, g); };",
              "const n = new Date(); const bugun = Date.UTC(n.getUTCFullYear(), n.getUTCMonth(), n.getUTCDate());",
              "pm.test(\"geçmiş tarihli yok, en yakın önce\", () => pm.response.json().forEach((e, i, a) => { pm.expect(gun(e.date)).to.be.at.least(bugun); if (i) pm.expect(gun(e.date)).to.be.at.least(gun(a[i - 1].date)); }));"
            ]
          }
        }
      ],
      "response": []
